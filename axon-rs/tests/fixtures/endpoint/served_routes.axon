// v2.89.0 (group B) — a program whose HTTP surface is actually served.
//
// `axonendpoint`'s claim is about typed routes; `axpoint` is its alias — the
// same TokenType, which is a claim that can only be checked by writing one and
// watching it behave identically. Neither had a program on disk being SERVED:
// the gates that deploy and fetch build their source inline.
//
// Two routes, one written each way. Both must deploy and both must stream.

flow PrimaryReview() -> Unit {
    step Assess {
        ask: "Assess the submitted case"
        output: Stream<Token>
    }
}

flow AliasReview() -> Unit {
    step Confirm {
        ask: "Confirm the assessment"
        output: Stream<Token>
    }
}

axonendpoint PrimaryRoute {
    method: POST
    path: "/fixture/primary"
    execute: PrimaryReview
    transport: sse public: true
}

axpoint AliasRoute {
    method: POST
    path: "/fixture/alias"
    execute: AliasReview
    transport: sse public: true
}
