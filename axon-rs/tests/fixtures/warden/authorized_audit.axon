// v2.89.0 (group B) — the `.axon` input `warden_wired.rs` never
// had.
//
// v2.67.0 made `warden` real and proved it at nine joints, but every one of
// those gates hand-builds `IRScope` and `IRWarden` in Rust. That proves the
// HANDLER. Law 4 asks for the PATH: a program an adopter could write, compiled
// by the real pipeline, dispatched through the real node. This file is that
// program, and the gate that reads it mounts the same `ReferenceStaticWarden`
// the runner mounts for every deployment.
//
// The C source below carries two defects the OSS reference analyzer detects
// deterministically: an unbounded copy (`strcpy`, no length bound) and a
// hard-coded secret. Both must come back as attested findings, each with a
// witness that passes `warden::verify`.

scope InternalAudit {
    targets: [ "payments_core" ]
    depth: static_artifact
    approver: "security.lead"
}

flow AuditPaymentsCore() -> Unit {
    let payments_core = "void load(char *in) { char buf[16]; strcpy(buf, in); } const char *password = \"hunter2\";"

    warden(payments_core) within InternalAudit {
        step Fortify {
            ask: "Propose hardening for the attested findings"
            output: Stream<Token>
        }
    }
}
