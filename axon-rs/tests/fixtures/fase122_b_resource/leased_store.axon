// §Fase 122.b (group B) — the `.axon` input `fase113_d_lease_breach_fires.rs`
// never had.
//
// `lease` was the sharpest case in the whole §111 line, and it is worth
// restating because it is what this fixture makes checkable: the kernel was
// never broken. `LeaseKernel` had `acquire`, `use_token`, `release`, the CT-2
// Anchor Breach and all three `on_expire` policies, and its unit tests passed
// for years. IT HAD NO SUBJECT. The README promised that using a resource after
// expiry is a breach — in a language where a flow could not USE a resource at
// all. A guarantee about using a thing that cannot be used is not a weak
// guarantee; it is a VACUOUS one: unviolatable, and therefore unkeepable.
//
// §113 made the store operation the use. This is that program, on disk: a
// one-hour window over an affine resource, and a store that can only be
// resolved while the capability is held.
//
// `backend: in_memory` keeps the gate free of a database — the lease is charged
// in `resolve()`, BEFORE any pool is touched, which is itself the point: an
// expired capability must not hand back a working handle of any kind.

resource Db {
    kind:      postgres
    endpoint:  "db.main"
    lifetime:  affine
}

lease Night {
    resource:   Db
    duration:   1h
    acquire:    on_start
    on_expire:  anchor_breach
}

axonstore Users {
    backend:  in_memory
    resource: Db
}
