// §Fase 122.b (group B) — the `.axon` input `fase111_d_quant_wired.rs` never
// had.
//
// §111.d made `quant` real: E = ⟨ψ|M|ψ⟩ computed by actual arithmetic, the
// block's body executing instead of being skipped, and a register above the OSS
// cap refused with `axon-E0783` rather than silently truncated. Every one of
// those gates hand-builds `IRObservable` and `IRQuant` in Rust — a proof of the
// HANDLER.
//
// This is the program an adopter would write. The observable below is the
// single-qubit Pauli-Z, whose ground state |0⟩ has expectation exactly +1, so
// the measurement is checkable by hand and not by a fixture-specific oracle.

observable GroundEnergy {
    qubits: 1
    term: 1.0 * "Z"
}

flow MeasureGroundState() -> Unit {
    quant(observable: GroundEnergy, qubits: 1) {
        let surrogate = "[0.0]"
        yield surrogate
    }
}
