// v2.89.0 (group B) — the `.axon` input the v2.67.0 gate never had.
//
// Same small, precisely-stated gap as the immune fixture: v2.67.0 already
// deploys through the real path. What it lacked is a program on disk, so
// nothing could catch the citation going stale.
//
// The manifest declares TWO resources. The gate registers an adapter for only
// one of them, so the world the `observe` reports is `{Db}` while the manifest
// believes `{Db, Cache}`. The Jaccard symmetric difference is 1/2 = 0.5 — real,
// MEASURED drift between the desired shape and the actual one, against a
// tolerance of 0.1. Before v2.67.0 that zero was assumed, because the loop
// compared the manifest against itself.

resource FixtureDb    { kind: postgres  endpoint: db.main }
resource FixtureCache  { kind: redis     endpoint: cache.main }

manifest Infra { resources: [FixtureDb, FixtureCache] }

observe World from Infra {
    sources: [FixtureDb, FixtureCache]
    quorum: 1
    timeout: 1s
    on_partition: fail
}

reconcile Keeper {
    observe: World
    tolerance: 0.1
    on_drift: alert
}
