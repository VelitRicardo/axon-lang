// v2.89.0 (group B) — the `.axon` input the v2.67.0 gate never had.
//
// This one is a SMALL gap, and worth saying so precisely: v2.67.0 already drives
// the whole reflex arc through `POST /v1/deploy` — the real deploy path, the
// real supervisor, real ticks. It is a genuine source → dispatch proof already.
// The only thing Law 4 could not check is that its source is a Rust `format!`
// string, so no file on disk holds the program and nothing can verify the
// citation still compiles.
//
// Declared here, exactly as an adopter would: the resource and the manifest
// that scope it, the `observe` that samples it, the `immune` that learns a
// baseline over a 4-sample window, the `reflex` that quarantines on `doubt`,
// and the `heal` that renders an audit-only decision. The probe named below is
// registered by the gate as a source adapter whose reading it controls.

resource Db { kind: postgres  endpoint: db.main }

manifest Infra { resources: [Db] }

observe Health from Infra {
    sources: [fixture_probe]
    quorum: 1
    timeout: 1s
    on_partition: fail
}

immune Sentinel {
    watch: [Health]
    scope: tenant
    window: 4
    sensitivity: 0.8
    tau: 5m
}

reflex Quarantine {
    trigger: Sentinel
    on_level: doubt
    action: quarantine
    scope: tenant
    sla: 1ms
}

heal Repair {
    source: Sentinel
    on_level: doubt
    mode: audit_only
    scope: tenant
}
