// META: flow_name=RegulatedIntake, mode=count_only
//
// §Fase 122.b (group A) — `run`, `effects` and `compliance`.
//
// `run <Flow>(args)` is the top-level entry statement §65's unified executor
// binds and executes. `effects:` declares a tool's effect row, which is what
// §85 reads to derive cacheability from an `effects: pure` proof. `compliance:`
// on a regulated boundary is what `axon-T957` scopes — the ESK coverage law
// §117.a found had never existed.

tool PolicyLookup {
  provider: stub
  effects: <pure>
  timeout: 10s
}

persona RegulatedAnalyst {
  domain: ["regulatory-compliance"]
  tone: precise
  confidence_threshold: 0.9
}

flow RegulatedIntake() -> Unit {
  use PolicyLookup on "policy-catalogue"

  step Classify {
    ask: "Classify the intake against the policy catalogue"
    output: Stream<Token>
  }
}

run RegulatedIntake()

axonendpoint RegulatedIntakeEndpoint {
  method: POST
  path: "/cross/regulated-intake"
  execute: RegulatedIntake
  compliance: [PCI_DSS, SOC2]
  transport: sse public: true
}
