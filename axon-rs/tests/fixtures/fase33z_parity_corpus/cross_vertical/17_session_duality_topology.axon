// META: flow_name=SettlementDialogue, mode=count_only
//
// §Fase 122.b (group A) — a published program carrying a session-typed
// protocol and the topology that wires it.
//
// These are COMPILE-time claims, and the citation is chosen to match the KIND
// of claim: `check_session_duality` decides that the two roles are exact duals
// (send ↔ receive, select ↔ branch, arm-for-arm), and
// `check_topology_liveness` runs a DFS gray/black cycle detector emitting a
// Honda-liveness violation. The corpus gate COMPILES every fixture before it
// executes it, so both deductions run on this file on every corpus run.
//
// The pairing below is deliberately exact — `Buyer` and `Seller` are duals at
// every position, including inside the choice arms. Perturbing either side
// (flipping one `send` to `receive`, or renaming one arm) makes the gate fail
// on this fixture, which is what makes the citation mean something rather than
// merely parse.

type Quote {
  amount: String
}

type Settlement {
  reference: String
}

session SettlementProtocol {
  Buyer: [
    send Quote,
    receive Settlement,
    select {
      accept: [ send Settlement, end ],
      dispute: [ send Quote, end ]
    }
  ]
  Seller: [
    receive Quote,
    send Settlement,
    branch {
      accept: [ receive Settlement, end ],
      dispute: [ receive Quote, end ]
    }
  ]
}

// Topology nodes resolve to DECLARED entities (resource / fabric / manifest /
// observe / axonendpoint / axonstore / daemon / agent / shield) — not to the
// session's role names. These two shields declare no `scan:`, so they assert
// nothing about content and are never applied; they exist to be endpoints of
// the edge whose liveness is checked.
shield BuyerGuard {
  on_breach: halt
}

shield SellerGuard {
  on_breach: halt
}

topology SettlementMesh {
  nodes: [ BuyerGuard, SellerGuard ]
  edges: [ BuyerGuard -> SellerGuard : SettlementProtocol ]
}

flow SettlementDialogue() -> Unit {
  step Negotiate {
    ask: "Negotiate the settlement terms with the counterparty"
    output: Stream<Token>
  }
}

axonendpoint SettlementDialogueEndpoint {
  method: POST
  path: "/cross/settlement-dialogue"
  execute: SettlementDialogue
  transport: sse public: true
}
