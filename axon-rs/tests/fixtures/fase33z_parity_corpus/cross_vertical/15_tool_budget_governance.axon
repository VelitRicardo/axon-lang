// META: flow_name=ToolBudgetGovernance, mode=count_only
//
// §Fase 122.b (group A) — the FIRST `.axon` in this repository to declare a
// top-level `budget`. Measured 2026-08-13: none of the 107 existing `.axon`
// files uses it, so the primitive that §114.a rescued from being README prose
// still had no published program exercising it — the §119.f.8 shape, one level
// up.
//
// `use <Tool> on "<arg>"` is flow-level by construction (§54.a: a `use` inside
// a `step { }` body is a parse error), and the budget's ceiling binds on
// exactly that canonical dispatch path (§114.a).

tool LedgerLookup {
  provider: stub
  timeout: 10s
}

budget LookupCeiling {
  rate: 5 per minute on Tool(LedgerLookup)
}

flow ToolBudgetGovernance() -> Unit {
  use LedgerLookup on "account-42"

  step Summarize {
    ask: "Summarize the ledger lookup for the reviewer"
    output: Stream<Token>
  }
}

axonendpoint ToolBudgetGovernanceEndpoint {
  method: POST
  path: "/cross/tool-budget-governance"
  execute: ToolBudgetGovernance
  transport: sse public: true
}
