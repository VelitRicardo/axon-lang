// META: flow_name=QuarterlyDisclosure, mode=count_only
//
// §Fase 122.b (group A) — `document` and `notify`, the two governed-egress
// primitives whose laws are decided at COMPILE time: `axon-T916` validates the
// document's closed body vocabulary against its `target:` serializer, and
// §110's `axon-T933`/`T934`/`T935` require carried lineage or a refusal.
//
// `deliver` is deliberately absent: it requires a `secret:` under §94 custody
// (axon-T923), so it cannot be exercised by a fixture that mounts no minter.
// It belongs to group B, whose gates already mount the real ports.

document DisclosurePack {
  target: docx
  provenance: embedded
  effects: <io, storage>

  section {
    heading: "Quarterly disclosure"
    para { text: "Summary of the reporting period" }
  }
}

// Every clause below is REQUIRED by §110's laws, and the fixture kept the
// diagnostics that put them there: `axon-T934` refuses a channel outside the
// closed v1 catalog {sms, whatsapp, telegram}, refuses a literal recipient
// (a recipient is PII and never rides source, IR, prompts or audit — it must
// reference a §94 custody class), refuses a notification with no `template:`
// ("nothing to say is a declaration error"), and refuses one that does not
// declare the `web` effect it crosses. `axon-T935` refuses a missing `window:`
// — an unbounded interruption channel is a bug, not a default.
notify DisclosureReady {
  channel: sms
  to: secret(ops.oncall_phone)
  template: "The quarterly disclosure pack is ready for review."
  effects: <web>
  window: 4h
}

flow QuarterlyDisclosure() -> Unit {
  step Compose {
    ask: "Compose the quarterly disclosure summary"
    output: Stream<Token>
  }
}

axonendpoint QuarterlyDisclosureEndpoint {
  method: POST
  path: "/cross/quarterly-disclosure"
  execute: QuarterlyDisclosure
  transport: sse public: true
}
